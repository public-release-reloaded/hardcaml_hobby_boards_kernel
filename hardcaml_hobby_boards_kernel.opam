opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/hardcaml_hobby_boards_kernel"
bug-reports: "https://github.com/public-release-reloaded/hardcaml_hobby_boards_kernel/issues"
dev-repo: "git+https://github.com/public-release-reloaded/hardcaml_hobby_boards_kernel.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/hardcaml_hobby_boards_kernel/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "core_unix" {>= "v0.18~" & < "v0.19~"}
  "hardcaml" {>= "v0.18~" & < "v0.19~"}
  "hardcaml_axi" {>= "v0.18~" & < "v0.19~"}
  "jane_rope" {>= "v0.18~" & < "v0.19~"}
  "parsexp" {>= "v0.18~" & < "v0.19~"}
  "ppx_hardcaml" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_rope" {>= "v0.18~" & < "v0.19~"}
  "simple_xml" {>= "v0.18~" & < "v0.19~"}
  "stdio" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "Support code for FPGA hobby boards."
description: "
Interface code for FPGA hobby boards, useful library infrastructure, and build script generation.
"
